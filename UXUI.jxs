import React, { useState } from 'react';

export default function EasylifePlanner() {
  const [selectedTask, setSelectedTask] = useState(null);

  const tasks = [
    { id: 1, name: "Read Biology", priority: "High", due: "Today", done: false },
    { id: 2, name: "Database Setup", priority: "Medium", due: "Tomorrow", done: false }
  ];

  return (
    <div className="flex h-screen bg-gray-50 font-sans">
      {/* Left Sidebar */}
      <aside className="w-64 bg-white border-r p-5 shadow-sm flex flex-col justify-between">
        <div>
          <h1 className="text-2xl font-bold text-blue-600 mb-8">Easylife Planner</h1>
          <nav className="space-y-4 text-gray-600">
            <a href="#" className="block hover:text-blue-500 font-semibold">Dashboard</a>
            <a href="#" className="block hover:text-blue-500">Calendar</a>
            <a href="#" className="block hover:text-blue-500">Statistics</a>
          </nav>
        </div>
      </aside>

      {/* Center Workspace */}
      <main className="flex-1 p-8 overflow-y-auto">
        {/* 7-Column Routine Board */}
        <section className="mb-10">
          <h2 className="text-xl font-bold mb-4">Weekly Routine</h2>
          <div className="grid grid-cols-7 gap-2">
            {['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map(day => (
              <div key={day} className="bg-white p-3 rounded shadow-sm border min-h-[100px]">
                <span className="font-semibold text-gray-500 text-sm">{day}</span>
              </div>
            ))}
          </div>
        </section>

        {/* Task Table */}
        <section>
          <h2 className="text-xl font-bold mb-4">Tasks</h2>
          <div className="bg-white rounded shadow-sm border overflow-hidden">
            <table className="w-full text-left">
              <thead className="bg-gray-100 border-b text-gray-600">
                <tr>
                  <th className="p-3 w-10">Done</th>
                  <th className="p-3">Name</th>
                  <th className="p-3 w-32">Priority</th>
                  <th className="p-3 w-32">Due Date</th>
                </tr>
              </thead>
              <tbody>
                {tasks.map(task => (
                  <tr
                    key={task.id}
                    onClick={() => setSelectedTask(task)}
                    className="border-b hover:bg-gray-50 cursor-pointer transition-colors"
                  >
                    <td className="p-3"><input type="checkbox" /></td>
                    <td className="p-3 font-medium">{task.name}</td>
                    <td className="p-3">
                      <span className="px-2 py-1 bg-red-100 text-red-700 rounded text-xs">
                        {task.priority}
                      </span>
                    </td>
                    <td className="p-3 text-gray-500">{task.due}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </main>

      {/* Animated Right Sidebar */}
      <aside
        className={`fixed inset-y-0 right-0 w-80 bg-white shadow-2xl border-l transform transition-transform duration-300 ease-in-out ${
          selectedTask ? 'translate-x-0' : 'translate-x-full'
        }`}
      >
        {selectedTask && (
          <div className="p-6">
            <div className="flex justify-between items-center mb-6">
              <h3 className="text-xl font-bold">{selectedTask.name}</h3>
              <button onClick={() => setSelectedTask(null)} className="text-gray-400 hover:text-black">
                ✕
              </button>
            </div>
            <p className="text-sm text-gray-600 mb-4">Priority: {selectedTask.priority}</p>
            <p className="text-sm text-gray-600">Due: {selectedTask.due}</p>
            <div className="mt-8">
              <h4 className="font-semibold mb-2">Description & Notes</h4>
              <textarea
                className="w-full p-2 border rounded resize-none h-32 focus:outline-none focus:ring-2 focus:ring-blue-500"
                placeholder="Add details here..."
              ></textarea>
            </div>
          </div>
        )}
      </aside>
    </div>
  );
}